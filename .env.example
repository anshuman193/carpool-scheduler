VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_ENABLE_DEMO_LOGIN=true

# Set to 'true' to require login on every app restart/visit (default in dev).
# Set to 'false' to persist user sessions across restarts via localStorage (default in prod).
VITE_REQUIRE_LOGIN_EVERYTIME=true
